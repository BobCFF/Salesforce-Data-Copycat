# ---------------------------------------------------------------------------
# Salesforce Data Copycat - server configuration
# Copy this file to `.env` and adjust as needed. Never commit your real .env.
# ---------------------------------------------------------------------------

# Port the API server listens on.
PORT=4000

# Comma-separated list of allowed browser origins (the client dev server, etc).
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign the session cookie. MUST be set to a long random string
# in production. If unset, an ephemeral random secret is generated at startup
# (which invalidates sessions on every restart).
SESSION_SECRET=

# Set to "true" only when serving over HTTPS so the session cookie is marked
# Secure. Leave false for local http development.
COOKIE_SECURE=false

# Session idle lifetime in minutes.
SESSION_TTL_MINUTES=120

# Optional: default Salesforce login URLs offered in the UI.
# (Production: https://login.salesforce.com  Sandbox: https://test.salesforce.com)

# ---------------------------------------------------------------------------
# Optional OAuth2 (web server flow) support.
# Register a Connected App in Salesforce and fill these in to enable the
# "Log in with Salesforce" button. Leave blank to use username/password login.
# ---------------------------------------------------------------------------
SF_OAUTH_CLIENT_ID=
SF_OAUTH_CLIENT_SECRET=
# Must exactly match the callback URL configured on the Connected App.
SF_OAUTH_REDIRECT_URI=http://localhost:4000/api/oauth/callback
